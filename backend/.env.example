# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Domain for SSL Certificate (required for HTTPS)
DOMAIN=webmailbellalliant.mooo.com

# Email for Let's Encrypt (required for certificate renewal)
LETSENCRYPT_EMAIL=admin@example.com

# Port Configuration (defaults: HTTP=80, HTTPS=443, app=3000)
# HTTP_PORT=80
# HTTPS_PORT=443
# PORT=3000

# Certificate Directory (defaults to ./certs)
# CERT_DIR=/path/to/certs

# Security Settings
# ENFORCE_HTTPS=true
